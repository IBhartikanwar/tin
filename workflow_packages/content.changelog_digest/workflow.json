{
  "package_format": "tin-workflow-package-v1",
  "definition": {
    "key": "content.changelog_digest",
    "title": "Draft a customer changelog from recent shipped work",
    "description": "Read merged pull requests and commits from the connected repository over a period and draft a customer-facing changelog entry for review.",
    "executor": "codex.procedure",
    "version": "1.0.0",
    "schedule_modes": ["on_demand", "weekly"],
    "input_schema": {
      "type": "object",
      "additionalProperties": false,
      "required": ["project_id", "expected_repository"],
      "properties": {
        "project_id": { "type": "string", "format": "uuid" },
        "expected_repository": {
          "type": "string",
          "title": "Repository",
          "maxLength": 200,
          "x-tin-ui": { "order": 10 }
        },
        "lookback_days": {
          "type": "integer",
          "title": "Days to cover",
          "minimum": 1,
          "maximum": 90,
          "default": 7,
          "x-tin-ui": { "order": 20 }
        },
        "audience": {
          "type": "string",
          "title": "Who reads this",
          "maxLength": 300,
          "default": "",
          "x-tin-ui": { "control": "textarea", "order": 30 }
        },
        "voice_notes": {
          "type": "string",
          "title": "Tone or voice notes",
          "maxLength": 1000,
          "default": "",
          "x-tin-ui": { "control": "textarea", "order": 40 }
        }
      }
    },
    "procedure": {
      "prompt_path": "PROMPT.md",
      "skills_path": "skills",
      "skill_files": ["skills/changelog-digest/SKILL.md"],
      "entry_skill": "changelog-digest",
      "workspace": { "kind": "project.state" },
      "sandbox": { "profile": "isolated", "egress": "fenced", "timeout_seconds": 900 },
      "output": {
        "kind": "project.artifact",
        "path": "content/changelog/{run_id}.md",
        "media_type": "text/markdown",
        "max_bytes": 250000
      }
    }
  }
}
